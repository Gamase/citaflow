# Copia este archivo según el entorno. Ninguno de estos archivos se sube a git.
#
#   npm run dev                       → siempre usa http://localhost:3000 (VITE_API_URL se ignora);
#                                       client/.env solo para VITE_GOOGLE_CLIENT_ID
#   npm run build -- --mode staging   → lee .env.staging   (o VITE_API_URL en Render)
#   npm run build                     → lee .env.production (en la EC2)
#
# Solo URL pública del backend, sin secretos: todo VITE_* termina dentro del bundle.
VITE_API_URL="https://tu-backend.example.com"

# Opcional. Login con Google: el Client ID de Google Cloud (el mismo que GOOGLE_CLIENT_ID de la
# API; es público). Sin ella no aparece el botón "Continuar con Google".
# VITE_GOOGLE_CLIENT_ID="1234567890-xxxxxxxx.apps.googleusercontent.com"

# Copia este archivo según el entorno. Ninguno de estos archivos se sube a git.
#
#   npm run dev                       → no necesita .env: siempre usa http://localhost:3000
#   npm run build -- --mode staging   → lee .env.staging   (o VITE_API_URL en Render)
#   npm run build                     → lee .env.production (en la EC2)
#
# Solo URL pública del backend, sin secretos: todo VITE_* termina dentro del bundle.
VITE_API_URL="https://tu-backend.example.com"

DATABASE_URL="postgresql://your_db_user:your_secure_password_here@localhost:5432/your_db_name"
JWT_SECRET="your_jwt_signing_secret_here"
# Orígenes del front permitidos por CORS, separados por coma (sin / al final).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Proxies delante de la API (para la IP real del rate limit). 0 en DEV, 1 con Nginx (Prod).
# Si no se define, vale 1. En Render: el valor medido (ver DEMO.md).
TRUST_PROXY=0

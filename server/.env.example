# Conexión de la API. En DEV: el rol citaflow_app (ver scripts/rol-app-dev.sql), que no es
# superusuario ni tiene BYPASSRLS; si no, Postgres no le aplica RLS. En Render y Prod solo
# existe esta variable (con el dueño de las tablas; FORCE RLS hace que le apliquen las políticas).
DATABASE_URL="postgresql://citaflow_app:your_app_password@localhost:5432/your_db_name"
# Solo DEV: el dueño de las tablas (citaflow_user de Docker), para migraciones y seed:
#   npm run db:migrate          (prisma migrate dev con esta URL)
#   SEED_LABEL=dev npm run db:seed
DATABASE_URL_ADMIN="postgresql://your_db_user:your_secure_password_here@localhost:5432/your_db_name"
JWT_SECRET="your_jwt_signing_secret_here"
# Orígenes del front permitidos por CORS, separados por coma (sin / al final).
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
# Proxies delante de la API (para la IP real del rate limit). Obligatoria.
# 0 en DEV, 1 con Nginx (Prod), 3 en Render (medido, ver DEMO.md).
TRUST_PROXY=0

# Base de los enlaces que van en los correos (verificar correo, restablecer contraseña).
# Obligatoria. DEV: http://localhost:5173. Staging: la URL del static site de Render.
FRONTEND_URL="http://localhost:5173"
# Opcionales. Sin RESEND_API_KEY los correos (con su enlace) se imprimen en la consola del
# server. Con ella se mandan por la API HTTP de Resend (Render free bloquea SMTP) y el
# enlace NUNCA se escribe en los logs; entonces CORREO_REMITENTE es obligatoria.
# RESEND_API_KEY="re_xxxxxxxx"
# CORREO_REMITENTE="CitaFlow <no-reply@send.tudominio.com>"

# Opcional. Login con Google: el Client ID (OAuth, tipo "Aplicación web") de Google Cloud; no es
# secreto. Es el mismo que VITE_GOOGLE_CLIENT_ID del front, y sus "orígenes autorizados de
# JavaScript" deben incluir la URL del front. Sin ella el server arranca y /auth/google* responde 503.
# GOOGLE_CLIENT_ID="1234567890-xxxxxxxx.apps.googleusercontent.com"

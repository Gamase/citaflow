generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_ASISTIO
}

model Tenant {
  id       String   @id @default(uuid())
  nombre   String
  creadoEn DateTime @default(now())

  users        User[]
  services     Service[]
  clients      Client[]
  appointments Appointment[]
}

// Sin default a propósito: quien crea un usuario dice qué rol tiene
// (register → DUENO, /users → EMPLEADO). La migración dejó a los existentes como DUENO.
enum Rol {
  DUENO
  EMPLEADO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol
  // Nada se borra: un usuario desactivado pierde el acceso en su siguiente petición.
  activo    Boolean  @default(true)
  // Cuándo se cambió la contraseña, redondeado al segundo (el `iat` del JWT va en segundos).
  // verificarToken rechaza los tokens emitidos antes: cambiar la contraseña cierra las otras sesiones.
  passwordCambiadaEn DateTime?
  creadoEn  DateTime @default(now())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  // Citas asignadas a esta persona (Appointment.atiendeId).
  citasQueAtiende Appointment[]
}

model Service {
  id          String   @id @default(uuid())
  nombre      String
  duracionMin Int
  precio      Decimal
  creadoEn    DateTime @default(now())

  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, nombre])
}

model Client {
  id        String   @id @default(uuid())
  nombre    String
  telefono  String
  email     String?
  creadoEn  DateTime @default(now())

  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, telefono])
}

model Appointment {
  id        String     @id @default(uuid())
  fechaHora DateTime
  estado    EstadoCita @default(PENDIENTE)
  creadoEn  DateTime   @default(now())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])

  // Precio del servicio al momento de agendar: si después cambia el del servicio, esta
  // cita conserva el suyo. Opcional solo por la transición (ver migración); el código
  // nuevo siempre lo llena.
  precio    Decimal?

  // Quién atiende la cita (dueño o empleado del mismo negocio). null = "Sin asignar".
  // Cada persona tiene su propia agenda: el choque de horario se revisa por persona.
  atiendeId String?
  atiende   User?    @relation(fields: [atiendeId], references: [id])
}

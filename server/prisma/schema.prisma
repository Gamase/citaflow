generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_ASISTIO
}

model Tenant {
  id       String   @id @default(uuid())
  nombre   String
  creadoEn DateTime @default(now())

  users        User[]
  services     Service[]
  clients      Client[]
  appointments Appointment[]
}

// Sin default a propósito: quien crea un usuario dice qué rol tiene
// (register → DUENO, /users → EMPLEADO). La migración dejó a los existentes como DUENO.
enum Rol {
  DUENO
  EMPLEADO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol
  // Nada se borra: un usuario desactivado pierde el acceso en su siguiente petición.
  activo    Boolean  @default(true)
  // Cuándo se cambió la contraseña, redondeado al segundo (el `iat` del JWT va en segundos).
  // verificarToken rechaza los tokens emitidos antes: cambiar la contraseña cierra las otras sesiones.
  passwordCambiadaEn DateTime?
  // Cuándo confirmó su correo (null = sin verificar). Sin verificar puede usar la app, pero
  // no crear empleados ni cambiar su email. Los empleados que crea el dueño nacen verificados.
  emailVerificado DateTime?
  creadoEn  DateTime @default(now())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  // Citas asignadas a esta persona (Appointment.atiendeId).
  citasQueAtiende Appointment[]
  tokensCorreo    TokenCorreo[]
}

enum TipoTokenCorreo {
  VERIFICACION
  RESET
}

// Enlaces de un solo uso que se mandan por correo (verificar correo, restablecer contraseña).
// Solo se guarda el sha256 del token, nunca el token: con una copia de la BD no se pueden usar.
// Sin RLS (como User): se usa antes de saber el negocio. Nada se borra: un token usado o
// reemplazado por uno nuevo queda con `usadoEn`.
model TokenCorreo {
  id        String          @id @default(uuid())
  tipo      TipoTokenCorreo
  hash      String          @unique
  // El correo al que se mandó: si el usuario cambia su email, un enlace viejo no verifica el nuevo.
  email     String
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime        @default(now())

  userId    String
  user      User            @relation(fields: [userId], references: [id])

  @@index([userId, tipo])
}

model Service {
  id          String   @id @default(uuid())
  nombre      String
  duracionMin Int
  precio      Decimal
  creadoEn    DateTime @default(now())

  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, nombre])
}

model Client {
  id        String   @id @default(uuid())
  nombre    String
  telefono  String
  email     String?
  creadoEn  DateTime @default(now())

  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]

  @@unique([tenantId, telefono])
}

model Appointment {
  id        String     @id @default(uuid())
  fechaHora DateTime
  estado    EstadoCita @default(PENDIENTE)
  creadoEn  DateTime   @default(now())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])

  // Precio del servicio al momento de agendar: si después cambia el del servicio, esta
  // cita conserva el suyo.
  precio    Decimal

  // Quién atiende la cita (dueño o empleado del mismo negocio). null = "Sin asignar".
  // Cada persona tiene su propia agenda: el choque de horario se revisa por persona.
  atiendeId String?
  atiende   User?    @relation(fields: [atiendeId], references: [id])
}
